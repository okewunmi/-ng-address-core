{
  "name": "@ng-address/core",
  "version": "0.11.0",
  "description": "Production-grade Nigerian address intelligence core with deterministic parsing, national administrative resolution, postcode normalization, quality scoring and optional NIPOST adapter.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "check": "npm run build && npm test"
  },
  "keywords": [
    "nigeria",
    "address",
    "address-parser",
    "geocoding",
    "nipost",
    "postcode",
    "typescript",
    "logistics",
    "fintech"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {}
}
